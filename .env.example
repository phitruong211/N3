# Khi chạy Vite local, /api được proxy tới http://localhost:8080.
# Chỉ đổi giá trị này nếu frontend và backend được deploy ở hai origin khác nhau.
VITE_API_URL=/api/v1

# OAuth Client ID (loại Web) từ Google Cloud Console. Để trống thì ẩn nút Google.
# Thêm origin của frontend (vd. http://localhost:5173, https://n3-green.vercel.app) vào "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=
